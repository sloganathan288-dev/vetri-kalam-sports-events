# ============================================================================
#  VETRI KALAM Sports & Events — environment variables
#
#  Copy this file to `.env` for local development, and set the SAME keys in
#  Vercel → Project → Settings → Environment Variables for production.
#
#  `.env` is already listed in .gitignore and MUST NEVER be committed.
#  Every value below is a placeholder. There are no real credentials in this
#  repository — not in source, not in the browser bundle, not in the schema.
# ============================================================================

# --- PostgreSQL (Neon) -------------------------------------------------------
# Use the pooled connection string Neon gives you (it ends in -pooler and
# requires SSL). This is server-side only; it is never exposed to the browser.
DATABASE_URL=

# --- Organiser sign-in -------------------------------------------------------
# Checked in constant time by POST /api/auth. Use a long, unique
# password (a password manager passphrase is ideal). Never hard-code these.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Session signing ---------------------------------------------------------
# Random 32+ character string used to sign admin JWTs.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Optional ----------------------------------------------------------------
# Browser origin allowed to call the API. Leave unset for same-origin
# deployments (the Vercel URL); set it only if you host the frontend elsewhere.
ALLOWED_ORIGIN=

# Max PostgreSQL connections per warm function instance.
PG_POOL_MAX=

# Port used only by the local dev API server (npm run api).
API_PORT=
